"""
ai_matcher.py — Motor de scoring personalizado con Claude
=========================================================
Analiza proyectos mineros en lotes, infiere qué servicios necesitan,
y los compara contra el perfil de la empresa para generar un score preciso.

Mejoras v2:
  - Batch de 20 proyectos por llamada (antes: 1 por llamada)
  - Contexto completo: entry + raw (mineral, región, fase, mandante)
  - Análisis bidireccional: Claude infiere necesidades del proyecto
  - Prompt enriquecido con taxonomía de servicios mineros
  - ~10x más rápido, ~10x más barato

Variables de entorno:
  DATABASE_URL      — PostgreSQL connection string
  ANTHROPIC_API_KEY — Claude API key
"""

import os, sys, json, time
from typing import Any, Dict, List, Optional
import anthropic
import db

MODEL      = "claude-sonnet-4-6"
BATCH_SIZE = 20     # proyectos por llamada Claude
MAX_TOKENS = 4000
BATCH_DELAY = 1.0   # segundos entre batches


# ── Contexto completo del proyecto ─────────────────────────────────────────────
def format_project(opp: Dict) -> str:
    raw = opp.get("raw") or {}
    parts = [f"ID:{opp['id']} | {opp.get('title','')[:120]}"]
    if opp.get("company"):       parts.append(f"Mandante: {opp['company']}")
    if opp.get("region"):        parts.append(f"Región: {opp['region']}")
    if opp.get("phase"):         parts.append(f"Fase: {opp['phase']}")
    if opp.get("source"):        parts.append(f"Fuente: {opp['source']}")
    if raw.get("recurso"):       parts.append(f"Mineral: {raw['recurso']}")
    if raw.get("tipo_tramite"):  parts.append(f"Trámite: {raw['tipo_tramite']}")
    if raw.get("tipo_recurso"):  parts.append(f"Tipo recurso: {raw['tipo_recurso']}")
    # Entry tiene resumen textual rico
    entry = (opp.get("entry") or "")[:200]
    if entry and entry not in " ".join(parts):
        parts.append(f"Descripción: {entry}")
    return " | ".join(parts)


# ── Prompt batch ────────────────────────────────────────────────────────────────
def build_batch_prompt(batch: List[Dict], profile: Dict) -> str:
    company    = profile.get("company_name", "Mi empresa")
    services   = profile.get("services") or []
    regions    = profile.get("regions") or []
    mandantes  = profile.get("known_mandantes") or []
    sizes      = profile.get("contract_sizes") or []

    services_list = "\n".join(f"  • {s}" for s in services) if services else "  (no especificado)"
    regions_list  = ", ".join(regions) or "Todo Chile"
    mandantes_list = ", ".join(mandantes) or "todos"
    sizes_list    = ", ".join(sizes) or "no especificado"

    projects_block = "\n\n".join(
        f"[{i+1}] {format_project(opp)}" for i, opp in enumerate(batch)
    )

    return f"""Eres un experto en el sector minero chileno. Tu tarea es evaluar qué tan relevante es cada proyecto para una empresa proveedora.

═══ EMPRESA EVALUADA ═══
Nombre: {company}
Servicios que ofrece:
{services_list}
Regiones de operación: {regions_list}
Mandantes conocidos: {mandantes_list}
Rango de contratos: {sizes_list}

═══ PROYECTOS A EVALUAR ═══
{projects_block}

═══ INSTRUCCIONES ═══
Para cada proyecto:
1. Analiza qué servicios mineros probablemente necesita (perforación, campamentos, tecnología, transporte, etc.)
2. Compara con los servicios que ofrece la empresa
3. Considera la región y si el mandante es conocido
4. Asigna un score de fit (0-100)

Criterios:
- 85-100: Match directo — la empresa ofrece exactamente lo que necesita este proyecto
- 65-84:  Match alto — alta probabilidad de participación
- 45-64:  Match moderado — participación posible en alguna etapa
- 20-44:  Match bajo — relación lejana o indirecta
- 0-19:   Sin match — el proyecto no necesita estos servicios

Responde SOLO con JSON válido, sin markdown ni texto adicional:
{{
  "results": [
    {{
      "id": <id numérico del proyecto>,
      "fit_score": <0-100>,
      "services_needed": ["servicio1", "servicio2"],
      "fit_reason": "<1-2 oraciones explicando el match o la falta de él>",
      "service_applicable": "<el servicio más relevante de la empresa, o 'Ninguno'>",
      "contact_suggestion": "<rol a contactar, ej: Jefe de Abastecimiento, Gerente de Proyectos>"
    }}
  ]
}}"""


# ── Llamada a Claude ────────────────────────────────────────────────────────────
def score_batch(
    client: anthropic.Anthropic,
    batch: List[Dict],
    profile: Dict
) -> List[Dict]:
    prompt = build_batch_prompt(batch, profile)
    id_set = {opp["id"] for opp in batch}

    try:
        msg = client.messages.create(
            model=MODEL,
            max_tokens=MAX_TOKENS,
            messages=[{"role": "user", "content": prompt}]
        )
        raw = msg.content[0].text.strip()
        raw = raw.replace("```json", "").replace("```", "").strip()
        data = json.loads(raw)
        results = data.get("results", [])

        validated = []
        for r in results:
            rid = r.get("id")
            if rid not in id_set:
                continue
            validated.append({
                "id":                rid,
                "fit_score":         max(0, min(100, int(r.get("fit_score", 0)))),
                "services_needed":   r.get("services_needed", []),
                "fit_reason":        str(r.get("fit_reason", ""))[:500],
                "service_applicable":str(r.get("service_applicable", ""))[:200],
                "contact_suggestion":str(r.get("contact_suggestion", ""))[:200],
            })
        return validated

    except json.JSONDecodeError as e:
        print(f"  [ai] JSON error: {e} | raw[:200]: {raw[:200]}")
        return []
    except Exception as e:
        print(f"  [ai] Error batch: {type(e).__name__}: {e}")
        return []


# ── Runner principal ────────────────────────────────────────────────────────────
def run(company_key: str = "default", limit: int = 500) -> Dict:
    print(f"[ai_matcher] Iniciando para company_key='{company_key}'")

    api_key = os.getenv("ANTHROPIC_API_KEY")
    if not api_key:
        print("[ai_matcher] ERROR: ANTHROPIC_API_KEY no configurada")
        return {"error": "no_api_key"}

    profile = db.get_service_profile(company_key)
    if not profile:
        print(f"[ai_matcher] Sin perfil para '{company_key}'")
        return {"error": "no_profile"}

    services = profile.get("services") or []
    if not services:
        print("[ai_matcher] Perfil sin servicios")
        return {"error": "no_services"}

    print(f"[ai_matcher] {profile.get('company_name')} | {len(services)} servicios")

    # Cargar proyectos — todos excepto noticias puras
    opps = db.list_opportunities_for_ai_scoring(user_id=company_key, limit=limit)
    print(f"[ai_matcher] {len(opps)} proyectos a evaluar")

    if not opps:
        return {"scored": 0, "total": 0}

    client  = anthropic.Anthropic(api_key=api_key)
    scored  = 0
    errors  = 0
    batches = [opps[i:i+BATCH_SIZE] for i in range(0, len(opps), BATCH_SIZE)]

    for bi, batch in enumerate(batches, 1):
        print(f"  [batch {bi}/{len(batches)}] {len(batch)} proyectos...")
        results = score_batch(client, batch, profile)

        for r in results:
            # Guardar services_needed en el fit_reason enriquecido
            services_needed_str = ", ".join(r["services_needed"][:5]) if r["services_needed"] else ""
            reason = r["fit_reason"]
            if services_needed_str:
                reason = f"Servicios requeridos: {services_needed_str}. {reason}"

            db.upsert_ai_fit(
                opportunity_id    = r["id"],
                user_id           = company_key,
                fit_score         = r["fit_score"],
                fit_reason        = reason[:500],
                service_applicable= r["service_applicable"],
                contact_suggestion= r["contact_suggestion"],
                model_version     = MODEL,
            )
            scored += 1

        if results:
            sample = results[0]
            print(f"    → ejemplo: id={sample['id']} score={sample['fit_score']} | {sample['fit_reason'][:70]}")
        else:
            errors += 1

        if bi < len(batches):
            time.sleep(BATCH_DELAY)

    print(f"[ai_matcher] DONE — scored={scored} errors={errors} batches={len(batches)}")
    return {"scored": scored, "total": len(opps), "batches": len(batches)}


if __name__ == "__main__":
    db.init_ai_db()
    company_key = sys.argv[1] if len(sys.argv) > 1 else "default"
    run(company_key)
